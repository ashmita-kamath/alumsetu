PORT=5050
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/alumsetu?sslmode=verify-full
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me
# Websites allowed to call the API (comma-separated). * matches Vercel preview links.
# Production example: https://alumsetu.vercel.app,https://alumsetu-*.vercel.app
CLIENT_URL=http://localhost:5173
